# Vercel Postgres / Neon (both auto-inject these when connected via the Storage tab).
# Locally: paste the same values from Vercel → Project → Settings → Environment Variables.
POSTGRES_PRISMA_URL="postgresql://user:pass@host/db?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NON_POOLING="postgresql://user:pass@host/db?sslmode=require"

# NextAuth
AUTH_SECRET=""            # generate: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com -> Credentials -> OAuth 2.0 Client ID)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
