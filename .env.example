# Vercel Postgres (or any Postgres). Vercel injects DATABASE_URL automatically when the integration is added.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# Optional: pooled URL for serverless (Vercel Postgres provides POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING)
# POSTGRES_PRISMA_URL=""
# POSTGRES_URL_NON_POOLING=""

# NextAuth
AUTH_SECRET=""            # generate: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com -> Credentials -> OAuth 2.0 Client ID)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
